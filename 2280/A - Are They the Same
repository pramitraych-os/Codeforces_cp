#include <bits/stdc++.h>
typedef long long ll;
using namespace std;
 
int main() {
	int t;
	cin>>t;
	while(t--){
	    ll n,k;
	    cin>>n>>k;
	    vector<int>a(n),b(n);
	    int ao=0,ae=0,be=0,bo=0;
	    for(int i=0;i<n;i++){
	        cin>>a[i];
	        if(a[i]%2==0){
	            ae++;
	        }else{
	            ao++;
	        }
	    }
	    for(int i=0;i<n;i++){
	        cin>>b[i];
	        if(b[i]%2==0){
	            be++;
	        }else{
	            bo++;
	        }
	    }
	    if(k%2==0){
	        if(ao>=bo){
	            cout<<"YES"<<endl;
	        }else{
	            cout<<"NO"<<endl;
	        }
	    }else{
	        if(ae>=be){
	            cout<<"YES"<<endl;
	        }else{
	            cout<<"NO"<<endl;
	        }
	    }
	}
}